import math

number = int(input("Enter an integer: "))

is_prime = True

if number <= 1:
    is_prime = False
else:
    for divisor in range(2,number):
        if number % divisor == 0:
            is_prime = False
            break

if is_prime:
    print(f"{number} is a prime number.")
else:
    print(f"{number} is not a prime number.")

# Note: checking divisors only up to int(number ** 0.5) + 1 gives the same
# correct result but runs much faster for large numbers.